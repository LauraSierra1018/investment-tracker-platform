# Add the provider fields below to your existing backend/.env.
# Keep the existing DATABASE_URL, OpenAI, Supabase and SnapTrade settings.
# Never commit .env or put provider credentials in frontend variables.
MASSIVE_API_KEY=
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Minimum spacing between requests, in seconds, per backend process.
# Adjust to the limits of your own plan; 429 always activates a cooldown.
MASSIVE_REQUEST_SPACING=12
FMP_REQUEST_SPACING=0.5
ALPHA_VANTAGE_REQUEST_SPACING=12
